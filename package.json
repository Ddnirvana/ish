{
  "name": "ish",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The intent shell: native zsh speed with Pi intelligence and durable system context",
  "bin": {
    "ish": "bin/ish",
    "intentd": "bin/intentd",
    "ishctl": "bin/ishctl"
  },
  "pi": {
    "extensions": [
      "./dist/src/pi-extension.js"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js && zsh -n shell/ish.zsh",
    "test:soak": "npm run build && node scripts/soak.mjs --iterations 200",
    "demo": "npm run build && node scripts/evaluate.mjs --iterations 5",
    "demo:jobs": "npm run build && bash scripts/demo.sh",
    "demo:gif": "npm run build && vhs demo/ish.tape",
    "demo:all": "npm run build && vhs demo/ish.tape && vhs demo/diagnostics.tape && vhs demo/capabilities.tape",
    "postinstall": "bash scripts/harden-dependencies.sh",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "pi-mcp-adapter": "2.21.0",
    "pi-web-access": "0.18.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT"
}
