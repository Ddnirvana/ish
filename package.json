{
  "name": "ish",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The intent shell: native zsh speed with Pi intelligence and durable system context",
  "bin": {
    "intentd": "dist/src/daemon-cli.js",
    "ishctl": "dist/src/ctl-cli.js"
  },
  "pi": {
    "extensions": [
      "./dist/src/pi-extension.js"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js && zsh -n shell/ish.zsh",
		"demo": "npm run build && node scripts/evaluate.mjs --iterations 5",
		"demo:jobs": "npm run build && bash scripts/demo.sh",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT"
}
