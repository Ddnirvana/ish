#!/bin/sh
set -eu

self=$0
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case "$target" in
    /*) self=$target ;;
    *) self=$(dirname "$self")/$target ;;
  esac
done
root=$(CDPATH= cd -- "$(dirname "$self")/.." && pwd)
if [ -z "${INTENTD_PI:-}" ] && [ -x "$root/node_modules/.bin/pi" ]; then
  INTENTD_PI="$root/node_modules/.bin/pi"
  export INTENTD_PI
fi
exec node "$root/dist/src/daemon-cli.js" "$@"
