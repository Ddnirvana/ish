#!/bin/sh
set -eu

self=$0
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case "$target" in
    /*) self=$target ;;
    *) self=$(dirname "$self")/$target ;;
  esac
done
root=$(CDPATH= cd -- "$(dirname "$self")/.." && pwd)
ctl="$root/dist/src/ctl-cli.js"
zsh_command=${ISH_ZSH:-zsh}
node_command=${ISH_NODE:-$root/runtime/node}
[ -x "$node_command" ] || node_command=node

case "${1:-}" in
  config|capability|mcp|doctor)
    command=$1
    shift
    PATH=$(dirname "$node_command"):$PATH
    export PATH
    exec "$node_command" "$ctl" "$command" "$@"
    ;;
  service)
    shift
    exec "$root/scripts/service.sh" "$@"
    ;;
  default-shell)
    ish_path=$(command -v ish 2>/dev/null || printf '%s' "$0")
    case "$ish_path" in
      /*) ;;
      *) ish_path=$(CDPATH= cd -- "$(dirname "$ish_path")" && pwd)/$(basename "$ish_path") ;;
    esac
    zsh_path=$(command -v "$zsh_command" 2>/dev/null || printf '%s' "$zsh_command")
    printf '%s\n' "ish does not change your login shell automatically."
    printf '%s\n' "1. Verify first: ish doctor"
    printf '%s\n' "2. Ask an administrator to add this exact path to /etc/shells: $ish_path"
    printf '%s\n' "3. Change it explicitly: chsh -s $ish_path"
    printf '%s\n' "4. Log out and back in."
    printf '%s\n' "Rollback: chsh -s $zsh_path"
    exit 0
    ;;
  --version|-v)
    exec "$node_command" -e "const p=require('$root/package.json'); console.log('ish '+p.version)"
    ;;
  help|-h|--help)
    printf '%s\n' "ish - the intent shell"
    printf '%s\n' "usage: ish [zsh arguments] | config | capability | mcp | doctor | service | default-shell"
    exit 0
    ;;
esac

export ISH_ROOT=$root
export PATH="$root/bin:$PATH"
export ISH_USER_ZDOTDIR=${ZDOTDIR:-$HOME}
export ISH_ZDOTDIR=$root/shell/zdot
export ZDOTDIR=$ISH_ZDOTDIR

if [ "$#" -eq 0 ] && [ -t 0 ] && [ -t 1 ]; then
  pty_platform=${ISH_PTY_PLATFORM:-$(uname -s)}
  expect_command=${ISH_EXPECT:-expect}
  if [ "${ISH_TRANSCRIPT_CAPTURE:-1}" = 0 ]; then
    export ISH_TRANSCRIPT_STATUS=disabled-by-user
  elif [ "${ISH_PTY_ACTIVE:-0}" = 1 ]; then
    :
  elif [ "$pty_platform" = Darwin ] && ! command -v "$expect_command" >/dev/null 2>&1; then
    export ISH_TRANSCRIPT_STATUS=unavailable-macos-expect
  elif [ "$pty_platform" = Darwin ] && [ ! -f "$root/scripts/macos-pty.exp" ]; then
    export ISH_TRANSCRIPT_STATUS=unavailable-macos-pty-helper
  elif [ "$pty_platform" != Darwin ] && ! command -v script >/dev/null 2>&1; then
    export ISH_TRANSCRIPT_STATUS=unavailable-script-command
  elif [ ! -f "$root/dist/src/transcript-recorder.js" ]; then
    export ISH_TRANSCRIPT_STATUS=unavailable-recorder
  else
    runtime_root=${ISH_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/tmp}/ish-$(id -u)}
    transcript_base=$runtime_root/transcripts
    umask 077
    mkdir -p -m 700 "$transcript_base"
    chmod 700 "$transcript_base"
    transcript_dir=$(mktemp -d "$transcript_base/shell.XXXXXX")
    fifo=$transcript_dir/output.fifo
    events=$transcript_dir/events.jsonl
    meta=$transcript_dir/meta
    pty_slave_file=""
    [ "$pty_platform" != Darwin ] || pty_slave_file=$transcript_dir/macos-pty-slave
    mkdir -p -m 700 "$meta"
    mkfifo -m 600 "$fifo"
    export ISH_TRANSCRIPT_EVENTS=$events
    export ISH_TRANSCRIPT_META_DIR=$meta
    export ISH_TRANSCRIPT_STATUS=active
    export ISH_PTY_ACTIVE=1
    export ISH_ZSH_CHILD=$zsh_command
    exec 9<>"$fifo"
    "$node_command" "$root/dist/src/transcript-recorder.js" "$fifo" "$events" "$meta" "$pty_slave_file" 9>&- &
    recorder_pid=$!
    cleanup_transcript() {
      exec 9>&- 2>/dev/null || true
      kill "$recorder_pid" 2>/dev/null || true
      wait "$recorder_pid" 2>/dev/null || true
      rm -rf "$transcript_dir"
    }
    trap cleanup_transcript EXIT HUP INT TERM
    transcript_status=0
    case "$pty_platform" in
      Linux)
        script -qef -O "$fifo" -c 'exec "$ISH_ZSH_CHILD"' 9>&- || transcript_status=$?
        ;;
      Darwin)
        "$expect_command" "$root/scripts/macos-pty.exp" "$fifo" "$zsh_command" "$pty_slave_file" 9>&- || transcript_status=$?
        ;;
      *)
        transcript_status=125
        ;;
    esac
    exec 9>&- 2>/dev/null || true
    wait "$recorder_pid" 2>/dev/null || true
    rm -rf "$transcript_dir"
    trap - EXIT HUP INT TERM
    exit "$transcript_status"
  fi
fi
exec "$zsh_command" "$@"
