#!/usr/bin/expect -f

if {$argc != 3} {
  puts stderr "usage: macos-pty.exp OUTPUT COMMAND SLAVE_FILE"
  exit 2
}

set output [lindex $argv 0]
set command [lindex $argv 1]
set slave_file [lindex $argv 2]
set timeout -1
log_file -noappend $output
spawn -noecho $command

proc sync_winsize {keep_raw} {
  global spawn_out
  if {![info exists spawn_out(slave,name)]} {
    return
  }
  if {[catch {set size [exec stty -f /dev/tty size]}] ||
      [scan [string trim $size] "%d %d" rows columns] != 2} {
    return
  }
  catch {exec stty -f $spawn_out(slave,name) rows $rows columns $columns}
  if {$keep_raw} {
    # A signal trap can run while interact owns the terminal. Reassert its
    # byte-at-a-time mode so keystrokes never fall back to cooked echo.
    catch {stty raw -echo}
  }
}

trap {sync_winsize 1} WINCH
sync_winsize 0
set slave_channel [open $slave_file w]
puts -nonewline $slave_channel $spawn_out(slave,name)
close $slave_channel

interact

set result [wait]
exit [lindex $result 3]
